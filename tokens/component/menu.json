    "bg": {
      "$value": "{surface.face}"
    },
    "text": {
      "$value": "{text.primary}"
    },
    "item-hover-bg": {
      "$value": "{select.bg}"
    },
    "item-hover-fg": {
      "$value": "{select.fg}"
    },
    "text-disabled": {
      "$value": "{text.disabled}"
    },
    "shortcut": {
